# The nginx image fills ${FRAME_ANCESTORS} from the environment at start.
# Every other $name below is an nginx variable and is left alone.

# Files are not fingerprinted: HTML is revalidated every time, the rest is
# cached briefly and revalidated by ETag.
map $sent_http_content_type $lab_expires {
    default        5m;
    ~^text/html    -1;
}

server {
    listen 80 default_server;
    server_name _;

    root /srv/lab;
    index index.html;

    server_tokens off;
    charset utf-8;
    charset_types text/css;
    # Behind Dokploy's proxy an absolute redirect would leak http:// and the
    # container port, so /experiments/font-split redirects with a relative Location.
    absolute_redirect off;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 256;
    gzip_types text/css;

    expires $lab_expires;

    # Server level only: an add_header inside a location drops all of these.
    # No X-Frame-Options, COOP or COEP: each one would stop the site framing a tool.
    # No HSTS: Cloudflare sends it for the zone.
    add_header Content-Security-Policy "frame-ancestors ${FRAME_ANCESTORS}" always;
    add_header X-Robots-Tag "noindex, indexifembedded" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        access_log off;
        expires off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # There is no lab home page or category page yet; the index lives on the main site.
    location ~ ^/(?:experiments/?)?$ {
        return 302 https://www.ivankristianto.com/lab/;
    }

    location ~ /\. {
        return 404;
    }

    # The image copies only whitelisted files into /srv/lab, so anything else is a 404.
    location / {
        try_files $uri $uri/ =404;
    }

    # A folder without index.html would be a 403; say 404 like any other missing path.
    error_page 403 = @not_found;
    location @not_found {
        return 404;
    }
}
